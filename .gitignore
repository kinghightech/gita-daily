# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# local agent/worktree metadata
.claude/

# typescript
*.tsbuildinfo

app-example

# native folders — ios/ is tracked (custom widget + native config);
# ignore only the generated / heavy / machine-specific bits
# Xcode build output (DerivedData, archives) at repo root
/build/
*.xcarchive
/ios/Pods/
/ios/build/
/ios/DerivedData/
/ios/.xcode.env.local
**/xcuserdata/
*.xcuserstate
/android
.env
